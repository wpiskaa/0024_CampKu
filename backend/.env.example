PORT=3000

# Database MySQL (default XAMPP: user root, password kosong)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campku

# Ganti dengan string acak yang panjang untuk produksi
JWT_ACCESS_SECRET=ganti-dengan-secret-access-yang-panjang
JWT_REFRESH_SECRET=ganti-dengan-secret-refresh-yang-berbeda

# Akun admin awal (dibuat oleh npm run db:init)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@campku.com
ADMIN_PASSWORD=admin123

